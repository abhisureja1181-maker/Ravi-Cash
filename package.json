{
  "name": "ravi-cash",
  "version": "1.0.0",
  "private": true,
  "description": "Cash Voucher & Cash Register Management System - Ravi Water Flow Pump (web app + Android PWA + self-hosted server + Supabase schema)",
  "scripts": {
    "start": "node tools/build.js && node server/index.js",
    "start:demo": "node tools/start-demo.js",
    "build": "node tools/build.js",
    "test": "node --test tests/*.test.js",
    "test:db": "bash supabase/tests/run.sh",
    "test:all": "npm test && npm run test:db",
    "single": "node tools/single-file.js"
  },
  "engines": {
    "node": ">=20"
  }
}
